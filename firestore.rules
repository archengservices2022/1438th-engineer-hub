rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && profileExists() && myProfile().status == 'Active'
        && (!myProfile().get('requiresEmailVerification', false) || request.auth.token.email_verified == true);
    }

    function isAdmin() {
      return isActive() && myProfile().role == 'Admin';
    }

    // users/{uid}: name, email, phone, role, status, createdAt
    match /users/{uid} {
      // A signed-in user can always read their own profile (needed to learn
      // they're still Pending); browsing everyone else's profile requires
      // an approved (Active) account.
      allow get: if isSignedIn() && (request.auth.uid == uid || isActive());
      allow list: if isActive();

      // Account self-registration: a user may only create their own
      // document, with the email that matches their auth token. A request
      // for any role (including Admin) always starts Pending and needs an
      // existing Admin's approval — except the single bootstrap admin
      // email, which starts Active so there's always at least one Admin.
      allow create: if ((isAdmin() || (isActive() && myProfile().role == 'NCO / Leader' && request.resource.data.role == 'Soldier'))
        && request.resource.data.role in ['Soldier','NCO / Leader','Admin']
        && request.resource.data.status == 'Active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.requiresEmailVerification == true
        && request.resource.data.emailVerified == false
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80)
        || (isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.requiresEmailVerification == true
        && request.resource.data.get('emailVerified',false) == request.auth.token.email_verified
        && request.resource.data.role in ['Soldier', 'NCO / Leader', 'Admin']
        && (
          (request.auth.token.email == 'sridharkota17@gmail.com'
            && request.resource.data.status == 'Active')
          ||
          (request.auth.token.email != 'sridharkota17@gmail.com'
            && request.resource.data.status == 'Pending')
        ));

      // Admins can edit/approve any profile (role, status, etc). A user may
      // update their own profile only if role/status stay unchanged, so
      // nobody can self-approve or self-promote.
      allow update: if (isAdmin() && (request.resource.data.status != 'Active' || resource.data.status != 'Pending' || !resource.data.get('requiresEmailVerification',false) || resource.data.get('emailVerified',false)))
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('createdBy','') == resource.data.get('createdBy','')
            && request.resource.data.get('requiresEmailVerification', false) == resource.data.get('requiresEmailVerification', false)
            && (request.resource.data.get('emailVerified',false) == resource.data.get('emailVerified',false) || request.resource.data.get('emailVerified',false) == request.auth.token.email_verified));

      allow delete: if isAdmin();
    }

    // appData/shared: published tasks, announcements, drills, activity,
    // notifications, account requests — shared app state for approved users.
    match /appData/{docId} {
      allow read, write: if isActive();
    }

    match /appData/recovery/snapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    function isSupportDeveloper() {
      return isActive() && exists(/databases/$(database)/documents/supportStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/supportStaff/$(request.auth.uid)).data.enabled == true;
    }
    match /supportStaff/{staffId} {
      allow get: if isActive() && (isAdmin() || request.auth.uid == staffId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['enabled','updatedBy','updatedAt']) && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }
    match /supportNotifications/{recipientId}/items/{noticeId} {
      function ticket() { return getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data; }
      function recipient() { return get(/databases/$(database)/documents/users/$(recipientId)).data; }
      function publicRecipient() { return recipient().role == 'Admin' || recipientId == ticket().requesterId || recipientId == ticket().get('assignedDeveloperId',''); }
      function eventData() { return request.resource.data.source == 'internalNotes'
        ? getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)/internalNotes/$(request.resource.data.eventId)).data
        : getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)/messages/$(request.resource.data.eventId)).data; }
      allow read: if isActive() && request.auth.uid == recipientId;
      allow create: if isActive() && recipientId != request.auth.uid
        && request.resource.data.keys().hasOnly(['ticketId','eventId','source','message','route','createdAt','userId','actorId','kind'])
        && request.resource.data.userId == recipientId && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.kind == 'support'
        && request.resource.data.message is string && request.resource.data.message.size() <= 400
        && request.resource.data.route == 'support-ticket/' + request.resource.data.ticketId
        && noticeId == request.resource.data.eventId && recipient().status == 'Active'
        && (request.resource.data.source == 'ticket'
          ? ticket().requesterId == request.auth.uid && ticket().createdAt == request.time && recipient().role == 'Admin' && request.resource.data.eventId == request.resource.data.ticketId
          : request.resource.data.source in ['messages','internalNotes'] && eventData().authorId == request.auth.uid && eventData().createdAt == request.time
            && (isAdmin() || ticket().requesterId == request.auth.uid || ticket().get('assignedDeveloperId','') == request.auth.uid)
            && (request.resource.data.source == 'internalNotes'
              ? recipient().role == 'Admin' || recipientId == ticket().get('assignedDeveloperId','')
              : publicRecipient()));
      allow update, delete: if false;
    }
    function formattedTicketNumber(n) {
      return 'TKT-' + (n < 10 ? '000' : n < 100 ? '00' : n < 1000 ? '0' : '') + string(n);
    }
    match /supportCounters/tickets {
      allow get: if isActive();
      allow create, update: if isActive()
        && request.resource.data.keys().hasOnly(['lastNumber','ticketId'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == (resource == null ? 1 : resource.data.lastNumber + 1)
        && !exists(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId))
        && getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data.requesterId == request.auth.uid
        && getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data.ticketNumber == formattedTicketNumber(request.resource.data.lastNumber);
    }
    match /supportTickets/{ticketId} {
      function ownsTicket() { return resource.data.requesterId == request.auth.uid; }
      function assignedDeveloper(data) { return isActive() && (isSupportDeveloper() || myProfile().role in ['Admin','NCO / Leader']) && data.get('assignedDeveloperId','') == request.auth.uid; }
      function staffFor(data) { return isAdmin() || assignedDeveloper(data); }
      function validTicket(data) {
        return data.keys().hasOnly(['requesterId','requesterName','subject','description','category','status','createdAt','updatedAt','lastActorId','assignedDeveloperId','ticketNumber','resolutionPath','resolutionSummary','verifiedBy','priority','clientNotifications'])
          && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100
          && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
          && data.requesterName is string && data.requesterName.size() <= 100
          && data.category in ['Account access','Tasks','Drills','Announcements','Resources','Other']
          && data.status in ['Open','In Progress','Escalated','Resolved']
          && data.get('priority','Normal') in ['Low','Normal','High'];
      }
      allow read: if isActive() && (isAdmin() || ownsTicket() || assignedDeveloper(resource.data));
      allow create: if isActive() && validTicket(request.resource.data)
        && request.resource.data.requesterId == request.auth.uid
        && !request.resource.data.keys().hasAny(['assignedDeveloperId','resolutionPath','resolutionSummary','verifiedBy','priority'])
        && getAfter(/databases/$(database)/documents/supportCounters/tickets).data.ticketId == ticketId
        && request.resource.data.ticketNumber == formattedTicketNumber(getAfter(/databases/$(database)/documents/supportCounters/tickets).data.lastNumber)
        && request.resource.data.status == 'Open'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActorId == request.auth.uid;
      allow update: if isActive() && (isAdmin() || ownsTicket()) && validTicket(request.resource.data)
        && request.resource.data.updatedAt == request.time && request.resource.data.lastActorId == request.auth.uid
        && (isAdmin()
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastActorId','assignedDeveloperId','resolutionPath','resolutionSummary','verifiedBy','priority','clientNotifications'])
            && request.resource.data.get('resolutionPath','Admin') in ['Admin','Team member','External developer']
            && (request.resource.data.get('resolutionPath','Admin') != 'Team member' ||
              (request.resource.data.get('assignedDeveloperId','') != ''
               && exists(/databases/$(database)/documents/users/$(request.resource.data.assignedDeveloperId))
               && get(/databases/$(database)/documents/users/$(request.resource.data.assignedDeveloperId)).data.status == 'Active'
               && get(/databases/$(database)/documents/users/$(request.resource.data.assignedDeveloperId)).data.role in ['Admin','NCO / Leader']))
            && (request.resource.data.status != 'Escalated' || request.resource.data.get('resolutionPath','') == 'External developer')
            && (request.resource.data.status != 'Resolved' ||
              (request.resource.data.get('resolutionSummary','') is string && request.resource.data.get('resolutionSummary','').size() > 0
               && (request.resource.data.get('verifiedBy','') == request.auth.uid || (resource.data.status == 'Resolved' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolutionSummary','verifiedBy','status'])))))
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastActorId','clientNotifications'])
            && (request.resource.data.status == resource.data.status || (resource.data.status == 'Resolved' && request.resource.data.status == 'Open')));
      allow delete: if false;
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data; }
        allow read: if isActive() && (staffFor(parent()) || parent().requesterId == request.auth.uid);
        allow create: if isActive() && (isAdmin() || parent().requesterId == request.auth.uid)
          && request.resource.data.keys().hasOnly(['authorId','authorName','body','kind','createdAt','clientNotifications'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
          && request.resource.data.kind in ['reply','status'] && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /internalNotes/{noteId} {
        function parent() { return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data; }
        allow read: if isActive() && staffFor(parent());
        allow create: if isActive() && staffFor(parent())
          && request.resource.data.keys().hasOnly(['authorId','authorName','body','kind','createdAt','externalName','externalEmail','externalReference','clientNotifications'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
          && (request.resource.data.kind in ['note','status'] || (isAdmin() && request.resource.data.kind == 'handoff'
            && request.resource.data.externalName is string && request.resource.data.externalName.size() <= 100
            && request.resource.data.externalEmail is string && request.resource.data.externalEmail.size() <= 254
            && request.resource.data.externalReference is string && request.resource.data.externalReference.size() <= 150)) && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
